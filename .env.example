# Copier en .env à côté du fichier docker-compose utilisé, puis renseigner.
# .env n'est pas suivi par git.

# --- Commun aux deux fichiers (docker-compose.yml et docker-compose.traefik.yml) ---

# Image à déployer (OPTIONNEL). Par défaut, l'image publique
# `ghcr.io/fuzzinvaders/gestock:latest` est utilisée : aucun login, rien à
# builder. Ne renseigne cette variable que pour t'en écarter — registre privé,
# image construite localement, ou tag figé plutôt que `latest` :
#   GESTOCK_IMAGE=ghcr.io/fuzzinvaders/gestock:1.0.0
# GESTOCK_IMAGE=

# Secret de signature des sessions. Recommandé : openssl rand -hex 32
# Si absent, un secret aléatoire est généré et conservé dans le volume de données ;
# le changer déconnecte tout le monde.
AUTH_SECRET=

# --- docker-compose.yml (local / sans Traefik) ---

# Port exposé sur ta machine si 8080 est déjà pris par autre chose.
# HOST_PORT=8090

# Origine publique de l'app, à ne renseigner QUE si tu mets toi-même un reverse
# proxy devant ce fichier (pour un déploiement Traefik, utilise plutôt
# docker-compose.traefik.yml et DOMAIN ci-dessous, qui déduit ORIGIN tout seul).
# Active une vérification anti-CSRF sur les requêtes d'écriture. En local,
# laisser vide (la vérification est simplement désactivée).
# ORIGIN=https://gestock.exemple.fr

# --- docker-compose.traefik.yml (déploiement derrière Traefik) ---

# Nom d'hôte servi par Traefik. OBLIGATOIRE pour ce fichier (rien d'autre à
# faire pour ORIGIN : il est déduit automatiquement de DOMAIN).
# DOMAIN=gestock.exemple.fr

# --- Open Food Facts (recherche des codes-barres) ---

# Identité déclarée à Open Food Facts. Leur charte demande un agent identifiable ;
# y mettre une adresse de contact est une courtoisie, pas une obligation.
# OFF_USER_AGENT=Gestock/1.0 (moi@exemple.fr)

# Base interrogée. À ne changer que pour viser un miroir ou couper la recherche
# en la pointant vers un service inexistant (l'appli reste utilisable, la saisie
# du nom se fait alors à la main).
# OFF_BASE_URL=https://world.openfoodfacts.org
